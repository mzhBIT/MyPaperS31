menu "Storage Configuration"

    config STORAGE_SD_PWR_CTRL_LDO_INTERNAL_IO
        depends on SOC_SDMMC_IO_POWER_EXTERNAL
        bool "SD card power supply comes from internal LDO IO"
        default y
        help
            Enable this when the SD card IO power is supplied by the ESP32-P4
            internal LDO. Disable it if the SD card is powered externally.

    config STORAGE_SD_PWR_CTRL_LDO_IO_ID
        depends on SOC_SDMMC_IO_POWER_EXTERNAL && STORAGE_SD_PWR_CTRL_LDO_INTERNAL_IO
        int "SD card LDO ID"
        default 4 if IDF_TARGET_ESP32P4

endmenu

menu "Wi-Fi Configuration"

    config WIFI_SETTING_CONNECT_TIMEOUT_MS
        int "Wi-Fi connect timeout in milliseconds"
        default 20000

endmenu

menu "Audio Radio Configuration"

    config AUDIO_RADIO_ENABLE_ON_BOOT
        bool "Start network radio on boot"
        default y

    config AUDIO_RADIO_NAME
        string "Default station name"
        default "CNR China Voice"

    config AUDIO_RADIO_URL
        string "Default station URL"
        default "http://ngcdn001.cnr.cn/live/zgzs/index.m3u8"

    config AUDIO_RADIO_OUTPUT_VOLUME
        int "Output volume"
        range 0 100
        default 30

    config AUDIO_RADIO_INPUT_GAIN_DB
        int "ES8311 input gain in dB"
        range 0 45
        default 30

    config AUDIO_RADIO_SAMPLE_RATE
        int "Codec output sample rate"
        default 48000

    config AUDIO_RADIO_I2C_PORT
        int "ES8311 I2C port"
        default 1 if IDF_TARGET_ESP32P4
        default 0

    config AUDIO_RADIO_I2C_SDA_GPIO
        int "ES8311 I2C SDA GPIO"
        default 7

    config AUDIO_RADIO_I2C_SCL_GPIO
        int "ES8311 I2C SCL GPIO"
        default 8

    config AUDIO_RADIO_I2S_MCLK_GPIO
        int "ES8311 MCLK GPIO"
        default 13

    config AUDIO_RADIO_I2S_SCLK_GPIO
        int "ES8311 SCLK/BCLK GPIO"
        default 12

    config AUDIO_RADIO_I2S_ASDOUT_GPIO
        int "ES8311 ASDOUT/DIN-to-ESP GPIO"
        default 11

    config AUDIO_RADIO_I2S_LRCK_GPIO
        int "ES8311 LRCK/WS GPIO"
        default 10

    config AUDIO_RADIO_I2S_DSDIN_GPIO
        int "ES8311 DSDIN/DOUT-from-ESP GPIO"
        default 9

    config AUDIO_RADIO_PA_CTRL_GPIO
        int "NS4150B PA_CTRL GPIO"
        default 53

endmenu
