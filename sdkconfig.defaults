CONFIG_FATFS_VFS_FSTAT_BLKSIZE=4096
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_USE_FASTSEEK=y
CONFIG_FATFS_FAST_SEEK_BUFFER_SIZE=64
CONFIG_ESP_MAIN_TASK_STACK_SIZE=24576
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=360
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="32MB"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_SPEED=200
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_PRE_CONFIGURE_MEMORY_PROTECTION=y
# CONFIG_SPIRAM_USE_MEMMAP is not set
# CONFIG_SPIRAM_USE_CAPS_ALLOC is not set
CONFIG_SPIRAM_USE_MALLOC=y
# Keep only very small generic allocations in internal RAM. Network packet
# payloads and TLS bookkeeping above 1 KiB can safely live in PSRAM.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
# Preserve a larger internal-only pool for SDMMC/GDMA descriptors and buffers.
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MEMTEST=y
# Keep protocol and timer-service work off the EPD scan core (core 1).
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_FREERTOS_TIMER_TASK_AFFINITY_CPU0=y
# Keep TLS session buffers and certificate working data out of scarce internal
# DMA memory. ESP32-P4 PSRAM is DMA-capable, so hardware AES remains enabled.
# CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC is not set
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_STORAGE_SD_PWR_CTRL_LDO_INTERNAL_IO=y
CONFIG_STORAGE_SD_PWR_CTRL_LDO_IO_ID=4
CONFIG_ESP_HOST_WIFI_ENABLED=n
CONFIG_ESP_WIFI_REMOTE_ENABLED=y
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_ENABLED=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_OPTIMIZATION_RX_STREAMING_MODE=y
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=54
# CONFIG_ESP_HOSTED_SDIO_CHECKSUM is not set
# CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE is not set
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_WIFI_SETTING_CONNECT_TIMEOUT_MS=20000
CONFIG_AUDIO_RADIO_ENABLE_ON_BOOT=n
CONFIG_AUDIO_RADIO_NAME="CNR China Voice"
CONFIG_AUDIO_RADIO_URL="http://ngcdn001.cnr.cn/live/zgzs/index.m3u8"
CONFIG_AUDIO_RADIO_OUTPUT_VOLUME=50
CONFIG_AUDIO_RADIO_INPUT_GAIN_DB=30
CONFIG_AUDIO_RADIO_SAMPLE_RATE=48000
CONFIG_AUDIO_RADIO_I2C_PORT=1
CONFIG_AUDIO_RADIO_I2C_SDA_GPIO=7
CONFIG_AUDIO_RADIO_I2C_SCL_GPIO=8
CONFIG_AUDIO_RADIO_I2S_MCLK_GPIO=13
CONFIG_AUDIO_RADIO_I2S_SCLK_GPIO=12
CONFIG_AUDIO_RADIO_I2S_ASDOUT_GPIO=11
CONFIG_AUDIO_RADIO_I2S_LRCK_GPIO=10
CONFIG_AUDIO_RADIO_I2S_DSDIN_GPIO=9
CONFIG_AUDIO_RADIO_PA_CTRL_GPIO=53
CONFIG_CODEC_ES8311_SUPPORT=y
CONFIG_ESP_AUDIO_SIMPLE_PLAYER_RESAMPLE_EN=y
CONFIG_AUDIO_SIMPLE_PLAYER_RESAMPLE_DEST_RATE=48000
CONFIG_ESP_AUDIO_SIMPLE_PLAYER_CH_CVT_EN=y
CONFIG_AUDIO_SIMPLE_PLAYER_CH_CVT_DEST=2
CONFIG_ESP_AUDIO_SIMPLE_PLAYER_BIT_CVT_EN=y
CONFIG_AUDIO_SIMPLE_PLAYER_BIT_CVT_DEST_16BIT=y
# The USB host enum driver reads a device's whole configuration descriptor into
# one buffer sized at build time, and rejects any device whose wTotalLength
# exceeds it (enum.c: "Configuration descriptor larger than control transfer max
# length"). UAC headsets are the worst case: an AudioControl interface plus one
# AudioStreaming interface per alternate setting, each with its own format and
# endpoint descriptors. The 256-byte default rejects working headsets at
# enumeration, before any of our code runs. One buffer per attached device.
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=1024
# RNDIS QUERY responses (notably OID_GEN_SUPPORTED_LIST) may be 1025 bytes.
# This is one control buffer per opened USB CDC device, not a packet buffer pool.
CONFIG_USBH_CDC_CONTROL_TRANSFER_BUFFER_SIZE=1025
# The HCD keeps two DMA buffers per pipe (NUM_BUFFERS in hcd_dwc.c) and refills
# one from its pending queue the moment the previous completes - in the ISR if a
# URB is already waiting, otherwise only when the app resubmits from the
# completion callback, which costs a round trip through the USB daemon task and
# the class driver's client task. Isochronous OUT packets are one 125 us
# microframe apart at High Speed bInterval=1, so a refill that misses its slot
# leaves the leading packets planted on frames that have already elapsed; the
# HCD reports that as USB_TRANSFER_STATUS_SKIPPED and this driver logs it as
# "TX URB: N/packets skipped".
#
# Four 16-packet URBs keep about 2 ms in each submitted transfer. A 32-packet
# test still lost packet zero at the end of an EPD PSRAM render burst, proving
# that external-memory bus starvation rather than insufficient queue depth was
# the limiting factor; keep the smaller setting to avoid needless DMA memory
# and latency.
CONFIG_UAC2_NUM_ISOC_URBS=4
CONFIG_UAC2_NUM_PACKETS_PER_URB=16
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MSC_BUFSIZE=32768
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=16384
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
