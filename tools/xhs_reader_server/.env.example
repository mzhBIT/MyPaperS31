XHS_DOWNLOADER_URL=http://host.docker.internal:15557
XHS_API_TOKEN=
XHS_VNC_PASSWORD=
# 默认复用已导入的 XHS-Downloader 镜像。若本机只有 GHCR 标签，在这里改用该标签。
# XHS_READER_BASE_IMAGE=ghcr.io/joeanamier/xhs-downloader:2.8
# 需要直接用局域网浏览器访问时，将下面的地址改为 NAS 内网 IP 并启用对应设置。
# XHS_API_BIND_ADDRESS=192.168.1.20
# XHS_VNC_BIND_ADDRESS=192.168.1.20
