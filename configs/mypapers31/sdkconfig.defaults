# Stage 2 display validation. Reference hardware uses Octal PSRAM.
# Optional modules are detected on demand; disable either on fixed variants.
CONFIG_MYPAPER_S31_CAMERA=y
CONFIG_MYPAPER_S31_CELLULAR=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="configs/mypapers31/partitions.csv"
# FreeType gray_convert_glyph alone uses a 16 KiB local render pool.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y
# GPIO58/59 belong to NT26 UART2. Keep console UART0 off these pads.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
# CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG is not set
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_MYPAPER_S31_TOUCH_ROTATION=1
# CONFIG_MYPAPER_S31_TOUCH_MIRROR_X is not set
# CONFIG_MYPAPER_S31_TOUCH_MIRROR_Y is not set
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_250M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
# Unlike P4, S31 cannot afford thousands of small ZIP/HTML/string allocations
# in internal SRAM. Prefer PSRAM even for small ordinary malloc/new requests.
# Explicit internal/DMA allocations and RTOS objects remain internal.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
# Native S31 receive-throughput trial (P4 hosted settings are independent).
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_RX_BA_WIN=32
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=16384
CONFIG_LWIP_TCP_WND_DEFAULT=65535
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
# CONFIG_ESP_WIFI_ENABLE_WIFI_TX_STATS is not set
# CONFIG_ESP_WIFI_ENABLE_WIFI_RX_STATS is not set
# CONFIG_ESP_WIFI_ENABLE_WIFI_RX_MU_STATS is not set

# USB Mass Storage (simulated U-disk). The dedicated boot mode initializes the
# SD card as a raw block device and never mounts /sdcard in the application.
CONFIG_TINYUSB_MSC_ENABLED=y
# Match P4. WRITE10 data is copied into this DMA buffer before the SD write,
# so bulk copies reach sdmmc as full multi-block transfers.
CONFIG_TINYUSB_MSC_BUFSIZE=32768
CONFIG_TINYUSB_MSC_MOUNT_PATH="/usbdata"
CONFIG_TINYUSB_MODE_DMA=y
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="MyPaperS31"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="MyPaperS31 SD Card"
CONFIG_TINYUSB_DESC_MSC_STRING="MyPaperS31 MSC"
# Network radio uses GMF HTTP/HLS decoding and a fixed BH1098G PCM output.
# Register HTTP explicitly with the certificate bundle in the S31 backend.
# CONFIG_ESP_AUDIO_SIMPLE_PLAYER_HTTP_EN is not set
CONFIG_ESP_AUDIO_SIMPLE_PLAYER_RESAMPLE_EN=y
CONFIG_ESP_AUDIO_SIMPLE_PLAYER_CH_CVT_EN=y
CONFIG_AUDIO_SIMPLE_PLAYER_CH_CVT_DEST=2
CONFIG_ESP_AUDIO_SIMPLE_PLAYER_BIT_CVT_EN=y
CONFIG_AUDIO_SIMPLE_PLAYER_BIT_CVT_DEST_16BIT=y
# Network radio uses GMF HTTP/HLS decoding and a fixed BH1098G PCM output.
# Register HTTP explicitly with the certificate bundle in the S31 backend.
# CONFIG_ESP_AUDIO_SIMPLE_PLAYER_HTTP_EN is not set
CONFIG_ESP_AUDIO_SIMPLE_PLAYER_RESAMPLE_EN=y
CONFIG_ESP_AUDIO_SIMPLE_PLAYER_CH_CVT_EN=y
CONFIG_AUDIO_SIMPLE_PLAYER_CH_CVT_DEST=2
CONFIG_ESP_AUDIO_SIMPLE_PLAYER_BIT_CVT_EN=y
CONFIG_AUDIO_SIMPLE_PLAYER_BIT_CVT_DEST_16BIT=y

# Shared UAC1/UAC2 Host, exclusive with the restart-isolated MSC device mode.
CONFIG_MYPAPER_USB_AUDIO=y
CONFIG_MYPAPER_USB_AUDIO_SOFTWARE_VOLUME=y
CONFIG_MYPAPER_USB_AUDIO_MAX_VOLUME=5

# Shared UAC1/UAC2 Host, exclusive with the restart-isolated MSC device mode.
CONFIG_MYPAPER_USB_AUDIO=y
CONFIG_MYPAPER_USB_AUDIO_SOFTWARE_VOLUME=y
CONFIG_MYPAPER_USB_AUDIO_MAX_VOLUME=5
# USB audio configurations commonly exceed the Host default of 256 bytes.
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=1024
