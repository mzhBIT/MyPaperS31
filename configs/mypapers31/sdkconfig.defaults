# Stage 2 display validation. Reference hardware uses Octal PSRAM.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="configs/mypapers31/partitions.csv"
# FreeType gray_convert_glyph alone uses a 16 KiB local render pool.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_MYPAPER_S31_TOUCH_ROTATION=1
# CONFIG_MYPAPER_S31_TOUCH_MIRROR_X is not set
# CONFIG_MYPAPER_S31_TOUCH_MIRROR_Y is not set
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_250M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
# Unlike P4, S31 cannot afford thousands of small ZIP/HTML/string allocations
# in internal SRAM. Prefer PSRAM even for small ordinary malloc/new requests.
# Explicit internal/DMA allocations and RTOS objects remain internal.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
# Match the validated P4 TCP buffers for bulk Wi-Fi uploads.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=16384
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
